# The primary for the RPZ zones Vessel's nodes subscribe to over Tailscale. Copy to nsd.conf and fill in the addresses:
# TAILSCALE_ADDRESS is this host's, and provide-xfr has one line per node (its Tailscale address).
server:
  ip-address: TAILSCALE_ADDRESS
  port: 5300
  username: ""
  chroot: ""
  zonesdir: "/z"
  database: ""
  pidfile: "/tmp/nsd.pid"
  xfrdfile: "/z/state/xfrd.state"
  xfrdir: "/tmp"
  zonelistfile: "/z/state/zone.list"
  verbosity: 2
  hide-version: yes
remote-control:
  control-enable: yes
  control-interface: /tmp/nsd.ctl
zone:
  name: "cti.rpz.vessel"
  zonefile: "cti.zone"
  provide-xfr: NODE_TAILSCALE_ADDRESS NOKEY
  store-ixfr: yes
  create-ixfr: yes
  ixfr-number: 5
  # no limit on the size of a change: a change over the default falls back to transferring the whole zone
  ixfr-size: 0
