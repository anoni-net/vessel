[Unit]
Description=Vessel inspection: analyse finished captures, then delete them
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/vessel-inspect.env
ExecStart=/usr/bin/python3 -I /opt/vessel-inspect-app/analyze.py batch
ExecStartPost=/usr/bin/python3 -I /opt/vessel-inspect-app/analyze.py purge --days 14
