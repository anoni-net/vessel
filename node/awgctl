#!/bin/bash
# awgctl: manage the peers of a Vessel node (the vessel-node container)
#
#   awgctl list [--json]                        peers with DNS filter, last handshake and transfer
#   awgctl add <name> [filter]                  create a peer with a server-generated key (filter: none|malware|ads),
#                                               print the path of its client config
#   awgctl add-pubkey <id> <pubkey> <psk> [filter]
#                                               create a peer from a browser-generated key; print JSON with
#                                               everything the client config needs except the private key
#   awgctl remove <name>                        revoke a peer immediately (suspended ones too)
#   awgctl suspend <name>                       take a peer offline but keep its keys on the node (quota used up)
#   awgctl resume <name>                        bring a suspended peer back
#   awgctl throttle on <name>                   hold a peer to about 2 Mbit/s each way (quota used up)
#   awgctl throttle off <name>                  back to full speed
#   awgctl show <name>                          print a client config created by `add`
#   awgctl usage --json                         transfer and blocked-lookup counters, when the interface came up
#   awgctl apply                                rebuild awg0.conf and sync it to the running interface
#   awgctl p2p                                  whole-node counts of BitTorrent-like packets, and of connections refused
#                                               over the per-device limit, since the container started
#   awgctl inspect on <name> <until>            copy a device's packets to the inspection stream until <until> (epoch
#                                               seconds); the node stops by itself at that time (toomore/anoni-net-ws#480)
#   awgctl inspect off <name>                   stop at once
#   awgctl inspect status --json                the devices being inspected
#   awgctl inspect confirms --json              confirmation codes opened on devices (host/vessel-inspect-confirm.py)
#   awgctl inspect ack <code>                   forget a confirmation the portal has read
#
# Layout under /opt/vessel-node:
#   node.env                  NODE_IP and LISTEN_PORT of this node (not in the repo)
#   server/interface.conf     [Interface] of the server (private key, port, AWG params)
#   server/client-params.conf AWG params copied into every client config,
#                             except Jc/Jmin/Jmax/I1 which are randomized per peer
#   peers/<name>.conf         [Peer] block on the server side
#   suspended/<name>.conf     [Peer] blocks taken offline by `suspend`; the preshared key never leaves the node
#   clients/<name>.conf       config from `add` (contains the private key); `add-pubkey` writes none
#   conf/awg0.conf            generated, mounted into the container
set -euo pipefail

D=/opt/vessel-node
C=vessel-node
IMG=vessel-node:latest
SUBNET=10.8.1
# the tunnel's private IPv6 range, the same as in start.sh; a peer's address ends in the same number as its IPv4 one
SUBNET6=fd60:f74e:973c::
# shellcheck source=/dev/null
. $D/node.env
: "${NODE_IP:?NODE_IP missing in $D/node.env}" "${LISTEN_PORT:?LISTEN_PORT missing in $D/node.env}"
# resolver address per DNS filter option, served by unbound inside the container
declare -A RESOLVER=([none]=10.8.1.1 [malware]=10.8.1.253 [ads]=10.8.1.254)

die() { echo "awgctl: $*" >&2; exit 1; }
awg_run() { docker run --rm -i --entrypoint awg $IMG "$@"; }
valid_name() { [[ $1 =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] || die "name must match [a-z0-9-], up to 32 chars"; }
valid_key() { [[ $1 =~ ^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$ ]] || die "$2 is not a WireGuard key"; }
valid_filter() { [ -n "${RESOLVER[$1]:-}" ] || die "filter must be one of: ${!RESOLVER[*]}"; }

# Inspection copies a device's packets to NFLOG group 42 (host/vessel-inspect-stream reads it). The first packets of a
# connection go whole, a TLS or QUIC hello needs them to show its server name; after that only the start of each
# packet, so what leaves the node is the headers and not the content. Each rule names the address it is for and
# carries its own end time, so a node that has lost the portal still stops.
INSPECT_GROUP=42
INSPECT_WHOLE=12    # packets of a connection copied whole
INSPECT_SNAP=128    # bytes copied of the packets after those
INSPECT_MAX_SECONDS=$(( 8 * 86400 ))

# Over its monthly quota a device is slowed down rather than taken offline (the portal's worker, enforce_quota). Each
# direction of its tunnel address is held to THROTTLE_RATE in VESSEL-THROTTLE, which FORWARD checks first; packets over
# the rate are dropped, and TCP and QUIC slow down to fit. A container restart loses the rules: `usage --json` says which
# addresses are throttled, and the worker puts back what is missing.
THROTTLE_RATE=256kb/s   # bytes, about 2 Mbit/s
THROTTLE_BURST=512kb

# VESSEL-THROTTLE, and FORWARD's jump to it as the first rule; made by the first call that needs them
throttle_chain() {
  docker exec $C iptables -t filter -S VESSEL-THROTTLE >/dev/null 2>&1 || docker exec $C iptables -t filter -N VESSEL-THROTTLE || return 1
  docker exec $C iptables -t filter -C FORWARD -j VESSEL-THROTTLE 2>/dev/null || docker exec $C iptables -t filter -I FORWARD 1 -j VESSEL-THROTTLE
}

# Remove the speed limit of a tunnel address. Like inspection, it must not carry over to the next device given the
# address, so callers stop when this fails.
throttle_clear() { # ipv4
  local rules line
  throttle_chain || return 1
  rules=$(docker exec $C iptables -t filter -S VESSEL-THROTTLE) || return 1
  { grep -E -- "--comment \"?vessel-throttle:${1//./\\.}\"?( |\$)" <<<"$rules" || true; } | sed -E 's/^-A /-D /' |
    while read -r line; do
      line=${line//\"/}
      # shellcheck disable=SC2086  # the rule's own words
      docker exec $C iptables -t filter $line || exit 1
    done
}

# the throttled tunnel addresses, one a line; none when the chain is not there yet
# VESSEL-NEW, VESSEL-P2P and VESSEL-LIMIT in node/start.sh, as name<TAB>packets: totals for the node since the
# container started, nothing per device. A chain a node does not have yet is left out.
node_totals() {
  local chain
  for chain in VESSEL-NEW VESSEL-P2P VESSEL-LIMIT; do docker exec $C iptables -nvxL $chain 2>/dev/null || true; done |
    awk '$1 ~ /^[0-9]+$/ { for (i = 1; i < NF; i++) if ($i == "/*") n[$(i + 1)] += $1 } END { for (k in n) print k "\t" n[k] }' | sort
}

throttle_list() {
  docker exec $C iptables -t filter -S VESSEL-THROTTLE 2>/dev/null | grep -oE 'vessel-throttle:[0-9.]+' | cut -d: -f2 | sort -u || true
}

# a peer's file, online or suspended
peer_file() { local f=$D/peers/$1.conf; [ -e "$f" ] || f=$D/suspended/$1.conf; [ -e "$f" ] && echo "$f"; }

throttle_on() { # name
  local f ip n
  f=$(peer_file "$1") || die "$1 not found"
  ip=$(peer_ip "$f"); n=${ip##*.}
  throttle_clear "$ip" || die "could not clear the speed limit of $1"
  # shellcheck disable=SC2206  # words
  local limit=(-m hashlimit --hashlimit-above $THROTTLE_RATE --hashlimit-burst $THROTTLE_BURST)
  if ! { docker exec $C iptables -t filter -A VESSEL-THROTTLE -i awg0 -s "$ip/32" -m comment --comment "vessel-throttle:$ip" \
           "${limit[@]}" --hashlimit-name "vt$n-up" -j DROP &&
         docker exec $C iptables -t filter -A VESSEL-THROTTLE -o awg0 -d "$ip/32" -m comment --comment "vessel-throttle:$ip" \
           "${limit[@]}" --hashlimit-name "vt$n-down" -j DROP; }; then
    # never one direction alone
    throttle_clear "$ip" || true
    die "could not add the speed limit"
  fi
  echo "throttled $1"
}

throttle_off() { # name
  local f
  f=$(peer_file "$1") || die "$1 not found"
  throttle_clear "$(peer_ip "$f")" || die "could not clear the speed limit of $1"
  echo "full speed for $1"
}

# Remove every inspection rule of a tunnel address. The next device given the address must not be copied, so callers
# stop when this fails.
inspect_clear() { # ipv4
  local rules line
  rules=$(docker exec $C iptables -t mangle -S) || return 1
  { grep -E -- "--comment \"?vessel-inspect:${1//./\\.}\"?( |\$)" <<<"$rules" || true; } | sed -E 's/^-A /-D /' |
    while read -r line; do
      # iptables -S quotes the comment; passed on as it is, the quotes would be part of it and no rule would match
      line=${line//\"/}
      # shellcheck disable=SC2086  # the rule's own words
      docker exec $C iptables -t mangle $line || exit 1
    done
}

# shellcheck disable=SC2086  # $match and $count are lists of words
inspect_add() { # chain, match words, ipv4, end time
  local chain=$1 match=$2 mark="vessel-inspect:$3" stop=$4 count="-m connbytes --connbytes-dir both --connbytes-mode packets"
  docker exec $C iptables -t mangle -A "$chain" $match $count --connbytes 0:$INSPECT_WHOLE \
    -m comment --comment "$mark" -m time --datestop "$stop" -j NFLOG --nflog-group $INSPECT_GROUP || return 1
  docker exec $C iptables -t mangle -A "$chain" $match $count --connbytes $(( INSPECT_WHOLE + 1 )): \
    -m comment --comment "$mark" -m time --datestop "$stop" -j NFLOG --nflog-group $INSPECT_GROUP --nflog-size $INSPECT_SNAP
}

inspect_on() { # name, until (epoch seconds)
  local f=$D/peers/$1.conf ip now stop
  [ -e "$f" ] || f=$D/suspended/$1.conf
  [ -e "$f" ] || die "$1 not found"
  [[ ${2:-} =~ ^[0-9]{1,12}$ ]] || die "until is epoch seconds"
  now=$(date +%s)
  (( $2 > now && $2 <= now + INSPECT_MAX_SECONDS )) || die "until must be in the future, within $(( INSPECT_MAX_SECONDS / 86400 )) days"
  ip=$(peer_ip "$f")
  stop=$(date -u -d "@$2" +%Y-%m-%dT%H:%M:%S)
  inspect_clear "$ip" || die "could not read or clear the inspection rules"
  if ! { inspect_add PREROUTING "-i awg0 -s $ip/32" "$ip" "$stop" && inspect_add POSTROUTING "-o awg0 -d $ip/32" "$ip" "$stop"; }; then
    # never half of it: one direction alone would be a wrong report
    inspect_clear "$ip" || true
    die "could not add the inspection rules"
  fi
  echo "inspecting $1 until $stop UTC"
}

inspect_off() { # name
  local f=$D/peers/$1.conf
  [ -e "$f" ] || f=$D/suspended/$1.conf
  [ -e "$f" ] || die "$1 not found"
  inspect_clear "$(peer_ip "$f")" || die "could not clear the inspection rules"
  echo "stopped inspecting $1"
}

# what host/vessel-inspect-confirm.py wrote: a file per tunnel address, holding the code confirmed from it. An old
# one is of no use to anybody
inspect_confirms() {
  [ -d $D/inspect-confirm ] || { echo '[]'; return; }
  find $D/inspect-confirm -maxdepth 1 -type f -mmin +60 -delete
  python3 -c '
import json, os, re, sys
d = sys.argv[1]
out = []
for address in sorted(os.listdir(d)):
    if re.fullmatch(r"[0-9.]+", address):
        with open(os.path.join(d, address)) as f:
            code = f.read().strip()
        if re.fullmatch(r"[A-Z0-9]{16}", code):
            out.append({"code": code, "address": address})
print(json.dumps(out))
' $D/inspect-confirm
}

# forget a confirmation the portal has read
inspect_ack() { # code
  local f
  [ -d $D/inspect-confirm ] || return 0
  for f in $D/inspect-confirm/*; do
    [ -f "$f" ] && [ "$(cat "$f")" = "$1" ] && rm -f "$f"
  done
  return 0
}

inspect_status() {
  local peers f
  peers=$(for f in $D/peers/*.conf $D/suspended/*.conf; do
    if [ -e "$f" ]; then printf '%s\t%s\n' "$(peer_ip "$f")" "$(basename "$f" .conf)"; fi
  done)
  docker exec $C iptables -t mangle -S | PEERS="$peers" python3 -c '
import datetime, json, os, re, sys
names = dict(line.split("\t") for line in os.environ["PEERS"].splitlines())
now = datetime.datetime.now(datetime.UTC).replace(tzinfo=None)
seen = {}
for line in sys.stdin:
    m = re.search(r"vessel-inspect:([0-9.]+)", line)
    stop = re.search(r"--datestop (\S+)", line)
    if m and stop:
        seen[m[1]] = stop[1]
print(json.dumps([{"name": names.get(ip), "address": ip, "until": until, "active": datetime.datetime.fromisoformat(until) > now}
                  for ip, until in sorted(seen.items())]))
'
}

apply() {
  local tmp
  umask 077
  tmp=$(mktemp $D/conf/.awg0.conf.XXXXXX)
  { cat $D/server/interface.conf
    for f in $D/peers/*.conf; do [ -e "$f" ] && { echo; cat "$f"; }; done
  } > "$tmp"
  mv "$tmp" $D/conf/awg0.conf
  docker exec $C sh -c 'f=$(mktemp) && awg-quick strip /etc/amnezia/amneziawg/awg0.conf > "$f" && awg syncconf awg0 "$f"; r=$?; rm -f "$f"; exit $r'
}

# the IPv4 tunnel address in a peer file
peer_ip() { awk -v s="$SUBNET." 'match($0, "AllowedIPs = " s "[0-9]+/") { print substr($0, RSTART + 13, RLENGTH - 14); exit }' "$1"; }

# Drop the kernel's connection tracking for a tunnel address. An established TCP flow stays tracked for five days,
# and without this the next device given the address would get the replies meant for the previous one. Nothing is
# printed: the entries name the sites the address was talking to. An image built without conntrack skips it.
forget_flows() { # ipv4
  docker exec $C sh -c 'command -v conntrack >/dev/null || exit 0
    conntrack -D -s "$1"; conntrack -D -d "$1"; conntrack -D -f ipv6 -s "$2"; conntrack -D -f ipv6 -d "$2"; exit 0' \
    sh "$1" "$(ip6_of "$1")" >/dev/null 2>&1 || true
}

# Client-only params (the server ignores them), so every peer gets its own values
# instead of the AmneziaVPN defaults shared by every self-hosted server.

# I1 shaped as a QUIC v1 Initial (RFC 9000 17.2.2), to match the node's UDP 443.
# Header protection masks the low 4 bits of the first byte and the packet number,
# and the payload is encrypted, so past the fixed fields a real Initial looks random:
# first byte 0xc0-0xcf, version 1, 8-byte DCID, empty SCID and token, a 2-byte length,
# then random bytes. <r N> is drawn again for every handshake, the rest is fixed per peer.
# The datagram is 1200-1252 bytes, the range clients pad their first Initial to.
quic_initial_i1() {
  local size rest
  size=$(shuf -i 1200-1252 -n1)
  rest=$(( size - 18 ))   # 1 + 4 + 1 + 8 + 1 + 1 + 2 header bytes
  printf '<b 0x%02x0000000108><r 8><b 0x0000%04x><r %d>\n' \
    $(( 0xc0 + RANDOM % 16 )) $(( 0x4000 | rest )) "$rest"
}

# [Interface] lines for a client, without Address/DNS/PrivateKey/MTU
client_params() {
  local jmin
  jmin=$(shuf -i 8-40 -n1)
  grep -v -E '^(Jc|Jmin|Jmax|I[1-5]) ' $D/server/client-params.conf
  printf 'Jc = %s\nJmin = %s\nJmax = %s\nI1 = %s\n' \
    "$(shuf -i 3-8 -n1)" "$jmin" "$(( jmin + $(shuf -i 20-200 -n1) ))" "$(quic_initial_i1)"
}

next_ip() {
  local used n
  # suspended peers keep their address for when they resume
  used=$(grep -h '^AllowedIPs' $D/peers/*.conf $D/suspended/*.conf 2>/dev/null | grep -oE "$SUBNET\.[0-9]+/32" | sed -E 's/.*\.([0-9]+)\/32/\1/')
  # .250-.254 are reserved for the node's own services
  for n in $(seq 2 249); do
    grep -qx "$n" <<<"$used" || { echo "$SUBNET.$n"; return; }
  done
  die "no free address in $SUBNET.0/24"
}

# a peer by this name, online or suspended
exists() { [ -e $D/peers/$1.conf ] || [ -e $D/suspended/$1.conf ]; }

# the IPv6 address that goes with an IPv4 tunnel address
ip6_of() { echo "$SUBNET6${1##*.}"; }

# write peers/<name>.conf; prints the peer's tunnel address (IPv4)
new_peer() { # name filter pubkey psk
  local ip
  ip=$(next_ip)
  # in case the previous holder's flows were not dropped when it was removed
  forget_flows "$ip"
  # nor may the previous holder's inspection carry over to whoever gets the address next
  inspect_clear "$ip" || die "could not clear the inspection rules of $ip"
  # nor a confirmation the previous holder made and the portal never read
  rm -f "$D/inspect-confirm/$ip"
  # and a speed limit belongs to the device that used up its quota, not to the address
  throttle_clear "$ip" || die "could not clear the speed limit of $ip"
  umask 077
  printf '[Peer]\n# %s\n# dns=%s\nPublicKey = %s\nPresharedKey = %s\nAllowedIPs = %s/32, %s/128\n' \
    "$1" "$2" "$3" "$4" "$ip" "$(ip6_of "$ip")" > $D/peers/$1.conf
  # the address's blocked-lookup counters (start.sh) start over for its new owner; rule n counts .n+1
  docker exec $C iptables -Z VESSEL-BLOCKED $(( ${ip##*.} - 1 )) >/dev/null 2>&1 || true
  docker exec $C iptables -Z VESSEL-ADS $(( ${ip##*.} - 1 )) >/dev/null 2>&1 || true
  echo "$ip"
}

peer_table() { # name<TAB>filter<TAB>pubkey for every peer file
  local f
  for f in $D/peers/*.conf; do
    [ -e "$f" ] || continue
    printf '%s\t%s\t%s\n' "$(basename "$f" .conf)" \
      "$(awk -F'=' '/^# dns=/{print $2}' "$f")" "$(awk -F' = ' '/^PublicKey/{print $2}' "$f")"
  done
}

cmd=${1:-}; name=${2:-}
case $cmd in
  add|add-pubkey|remove|suspend|resume|apply|inspect|throttle)
    # one change at a time: the portal and its worker can call at once, and two changes together could give two
    # peers the same address or sync a config the other is still writing
    exec 9>$D/.awgctl.lock
    flock -w 15 9 || die "busy, try again"
    ;;
esac
case $cmd in
  list|usage)
    json=0; [ "$name" = "--json" ] && json=1
    [ "$cmd" = usage ] && json=1
    started=$(docker inspect -f '{{.State.StartedAt}}' $C)
    { peer_table; echo "--"; docker exec $C awg show awg0 dump | tail -n +2
      echo "--"; docker exec $C iptables -nvxL VESSEL-BLOCKED 2>/dev/null | awk 'NR > 2 {print $9 "\t" $1}'
      echo "--"; docker exec $C iptables -nvxL VESSEL-ADS 2>/dev/null | awk 'NR > 2 {print $9 "\t" $1}'
      echo "--"; throttle_list
      echo "--"; if [ "$cmd" = usage ]; then node_totals; fi; } |
      CMD=$cmd JSON=$json STARTED=$started python3 -c '
import json, os, sys, time
peers, dump = {}, {}
lines = sys.stdin.read().splitlines()
sep = lines.index("--")
sep2 = lines.index("--", sep + 1)
sep3 = lines.index("--", sep2 + 1)
sep4 = lines.index("--", sep3 + 1)
sep5 = lines.index("--", sep4 + 1)
for l in lines[:sep]:
    name, flt, pub = l.split("\t")
    peers[pub] = (name, flt)
for l in lines[sep + 1:sep2]:
    f = l.split("\t")
    # allowed IPs are comma-separated; the IPv4 one names the peer in the counters
    v4 = [a for a in f[3].split(",") if "." in a]
    dump[f[0]] = {"address": v4[0].removesuffix("/32") if v4 else None, "latest_handshake": int(f[4]), "rx": int(f[5]), "tx": int(f[6])}
# blocked lookups per tunnel address: the malware list (VESSEL-BLOCKED) and the ad list (VESSEL-ADS); a chain
# a node does not have yet reads as zero
blocked = dict(l.split("\t") for l in lines[sep2 + 1:sep3] if "\t" in l)
ads = dict(l.split("\t") for l in lines[sep3 + 1:sep4] if "\t" in l)
throttled = set(lines[sep4 + 1:sep5])
# node-wide counts since the container started (node_totals), for the portal to notice P2P or a device at its limit
totals = {k: int(v) for k, v in (l.split("\t") for l in lines[sep5 + 1:] if "\t" in l)}
for d in dump.values():
    d["blocked"] = int(blocked.get(d["address"], 0))
    d["blocked_ads"] = int(ads.get(d["address"], 0))
    d["throttled"] = d["address"] in throttled
rows = []
for pub, (name, flt) in sorted(peers.items(), key=lambda kv: kv[1][0]):
    d = dump.get(pub, {"address": None, "latest_handshake": 0, "rx": 0, "tx": 0, "blocked": 0, "blocked_ads": 0, "throttled": False})
    rows.append({"name": name, "filter": flt, "public_key": pub, **d})
if os.environ["JSON"] == "1":
    if os.environ["CMD"] == "usage":
        rows = [{k: r[k] for k in ("name", "rx", "tx", "latest_handshake", "blocked", "blocked_ads", "throttled")} for r in rows]
        print(json.dumps({"interface_started": os.environ["STARTED"], "peers": rows, "totals": totals}))
    else:
        print(json.dumps(rows))
else:
    def size(n):
        for u in ("B", "K", "M", "G", "T"):
            if n < 1024: return f"{n:.0f}{u}" if u == "B" else f"{n:.1f}{u}"
            n /= 1024
        return f"{n:.1f}P"
    now = time.time()
    for r in rows:
        hs = "never" if not r["latest_handshake"] else str(int(now - r["latest_handshake"])) + "s ago"
        print("%-16s %-8s %-14s handshake %-12s rx %-10s tx %s" % (r["name"], r["filter"], r["address"] or "-", hs, size(r["rx"]), size(r["tx"])))
'
    ;;
  add)
    valid_name "$name"
    filter=${3:-none}
    valid_filter "$filter"
    exists "$name" && die "$name already exists"
    priv=$(awg_run genkey </dev/null); pub=$(echo "$priv" | awg_run pubkey); psk=$(awg_run genpsk </dev/null)
    srv_pub=$(docker exec $C awg show awg0 public-key)
    ip=$(new_peer "$name" "$filter" "$pub" "$psk")
    umask 077
    { printf '[Interface]\nAddress = %s/32, %s/128\nDNS = %s\nPrivateKey = %s\nMTU = 1280\n' "$ip" "$(ip6_of "$ip")" "${RESOLVER[$filter]}" "$priv"
      client_params
      printf '\n[Peer]\nPublicKey = %s\nPresharedKey = %s\nAllowedIPs = 0.0.0.0/0, ::/0\nEndpoint = %s:%s\nPersistentKeepalive = 25-35\n' \
        "$srv_pub" "$psk" "$NODE_IP" "$LISTEN_PORT"
    } > $D/clients/$name.conf
    apply
    echo "$D/clients/$name.conf"
    ;;
  add-pubkey)
    valid_name "$name"
    pub=${3:-}; psk=${4:-}; filter=${5:-none}
    valid_key "$pub" "public key"; valid_key "$psk" "preshared key"; valid_filter "$filter"
    exists "$name" && die "$name already exists"
    grep -qxF "PublicKey = $pub" $D/peers/*.conf $D/suspended/*.conf 2>/dev/null && die "public key already in use"
    srv_pub=$(docker exec $C awg show awg0 public-key)
    ip=$(new_peer "$name" "$filter" "$pub" "$psk")
    params=$(client_params)
    apply
    ADDRESS="$ip/32, $(ip6_of "$ip")/128" DNS="${RESOLVER[$filter]}" SRV_PUB="$srv_pub" ENDPOINT="$NODE_IP:$LISTEN_PORT" PARAMS="$params" NAME="$name" \
      python3 -c '
import json, os
iface = {"Address": os.environ["ADDRESS"], "DNS": os.environ["DNS"], "MTU": "1280"}
for line in os.environ["PARAMS"].splitlines():
    k, _, v = line.partition(" = ")
    iface[k] = v
peer = {"PublicKey": os.environ["SRV_PUB"], "AllowedIPs": "0.0.0.0/0, ::/0",
        "Endpoint": os.environ["ENDPOINT"], "PersistentKeepalive": "25-35"}
print(json.dumps({"name": os.environ["NAME"], "interface": iface, "peer": peer}))
'
    ;;
  remove)
    valid_name "$name"
    ip=
    for f in $D/peers/$name.conf $D/suspended/$name.conf; do
      [ -e "$f" ] && ip=$(peer_ip "$f")
    done
    found=0; exists "$name" && found=1
    # before the files go: a try that fails here finds the address again the next time
    if [ -n "$ip" ]; then
      inspect_clear "$ip" || die "could not clear the inspection rules of $name"
      throttle_clear "$ip" || die "could not clear the speed limit of $name"
      rm -f "$D/inspect-confirm/$ip"
    fi
    rm -f $D/peers/$name.conf $D/clients/$name.conf $D/suspended/$name.conf
    # apply even when the files are already gone: a try that deleted them and then failed to apply left the peer on
    # the interface, and the portal tries again
    apply
    [ -n "$ip" ] && forget_flows "$ip"
    [ "$found" = 1 ] || die "$name not found"
    echo "removed $name"
    ;;
  suspend)
    valid_name "$name"
    if [ -e $D/peers/$name.conf ]; then
      [ -d $D/suspended ] || mkdir -m 700 $D/suspended
      mv $D/peers/$name.conf $D/suspended/$name.conf
    elif [ ! -e $D/suspended/$name.conf ]; then
      die "$name not found"
    fi
    # also when it was already moved: an earlier try may have moved it and failed to apply
    apply
    echo "suspended $name"
    ;;
  resume)
    valid_name "$name"
    if [ -e $D/suspended/$name.conf ]; then
      mv $D/suspended/$name.conf $D/peers/$name.conf
    elif [ ! -e $D/peers/$name.conf ]; then
      die "$name not found"
    fi
    apply
    echo "resumed $name"
    ;;
  show)
    valid_name "$name"
    [ -e $D/clients/$name.conf ] || die "no client config for $name (peers from add-pubkey have none)"
    cat $D/clients/$name.conf
    ;;
  apply)
    apply
    ;;
  p2p)
    # VESSEL-NEW, VESSEL-P2P and VESSEL-LIMIT in node/start.sh: totals for the node, nothing per device
    echo "since $(docker inspect -f '{{.State.StartedAt}}' $C)"
    node_totals
    ;;
  throttle)
    case $name in
      on) valid_name "${3:-}"; throttle_on "$3" ;;
      off) valid_name "${3:-}"; throttle_off "$3" ;;
      *) die "throttle on <name> | off <name>" ;;
    esac
    ;;
  inspect)
    case $name in
      on) valid_name "${3:-}"; inspect_on "$3" "${4:-}" ;;
      off) valid_name "${3:-}"; inspect_off "$3" ;;
      status) inspect_status ;;
      confirms) inspect_confirms ;;
      ack)
        [[ ${3:-} =~ ^[A-Z0-9]{16}$ ]] || die "not a confirmation code"
        inspect_ack "$3"
        ;;
      *) die "inspect on <name> <until> | off <name> | status --json" ;;
    esac
    ;;
  *)
    sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
