#!/bin/bash
# Forced command for the portal's SSH key on a node. The key can run these awgctl calls and nothing else:
#
#   add-pubkey <id> <pubkey> <psk> <filter>
#   remove <id>
#   suspend <id>
#   resume <id>
#   list --json
#   usage --json
#   reach --json   the sites this node can open (host/vessel-reach.py), not an awgctl call
#   inspect on <id> <until>
#   inspect off <id>
#   inspect status --json
#   inspect confirms --json
#   inspect ack <code>
#
# authorized_keys on the node:
#   command="/usr/local/sbin/awgctl-remote",restrict,from="<portal host's tailnet IP>" ssh-ed25519 AAAA... vessel-portal
# awgctl validates ids, keys and filters itself.
set -euo pipefail
read -r -a a <<<"${SSH_ORIGINAL_COMMAND:-}"
case "${a[0]:-}:${#a[@]}" in
  add-pubkey:5) exec /usr/local/sbin/awgctl add-pubkey "${a[1]}" "${a[2]}" "${a[3]}" "${a[4]}" ;;
  remove:2)     exec /usr/local/sbin/awgctl remove "${a[1]}" ;;
  suspend:2)    exec /usr/local/sbin/awgctl suspend "${a[1]}" ;;
  resume:2)     exec /usr/local/sbin/awgctl resume "${a[1]}" ;;
  list:2)       [ "${a[1]}" = --json ] && exec /usr/local/sbin/awgctl list --json ;;
  usage:2)      [ "${a[1]}" = --json ] && exec /usr/local/sbin/awgctl usage --json ;;
  reach:2)      [ "${a[1]}" = --json ] && exec cat /opt/vessel-node/reach.json ;;
  inspect:4)    [ "${a[1]}" = on ] && exec /usr/local/sbin/awgctl inspect on "${a[2]}" "${a[3]}" ;;
  inspect:3)    [ "${a[1]}" = off ] && exec /usr/local/sbin/awgctl inspect off "${a[2]}"
                [ "${a[1]} ${a[2]}" = "status --json" ] && exec /usr/local/sbin/awgctl inspect status --json
                [ "${a[1]} ${a[2]}" = "confirms --json" ] && exec /usr/local/sbin/awgctl inspect confirms --json
                [ "${a[1]}" = ack ] && exec /usr/local/sbin/awgctl inspect ack "${a[2]}" ;;
esac
echo "awgctl-remote: command not allowed" >&2
exit 2
