[Unit]
Description=Vessel inspection: send the inspected devices' packets to the analysis host
After=docker.service tailscaled.service
Requires=docker.service

[Service]
ExecStart=/opt/vessel-node/host/vessel-inspect-stream.sh
# the container was recreated or the analysis host went away: start again with what is there now
Restart=on-failure
RestartSec=15
MemoryMax=200M

[Install]
WantedBy=multi-user.target
