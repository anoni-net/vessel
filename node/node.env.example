# Copy to /opt/vessel-node/node.env (mode 600). Not committed: it names the node.
NODE_IP=203.0.113.10
LISTEN_PORT=443
# the Tailscale address of the host that serves the blocklists (deploy/rpz)
RPZ_PRIMARY=
# where device inspection sends its packets (inspect/README.md): <tailnet IP>:<port> of the analysis host. Empty: nowhere
INSPECT_SINK=
# Only on a host with an agreed bandwidth limit: hold the uplink to this rate (host/vessel-net-tune.sh)
# UPLINK_RATE=24mbit
