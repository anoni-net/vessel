# DNSBunker's CTI list, subscribed from the NSD on the maintainers' host over Tailscale: only what changed is transferred, so
# the filter resolver pauses for a second or two instead of reloading the whole list. setup.sh writes cti-zone.conf from this
# file with CTI_PRIMARY from node.env. unbound writes the zone it received to zonefile, so a restart does not need the primary.
rpz:
  name: cti.rpz.vessel
  primary: CTI_PRIMARY@5300
  zonefile: "/var/lib/unbound-rpz/cti.rpz"
  rpz-log: no
  tags: "malware ads"
  # counted with the malware list
  rpz-signal-nxdomain-ra: yes
  rpz-action-override: nxdomain
