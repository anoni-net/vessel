# The blocklists, subscribed from the NSD on the maintainers' host over Tailscale (deploy/rpz): only what changed is
# transferred, so the filter resolver pauses for a second or two instead of reloading a whole list. setup.sh writes
# rpz-zones.conf from this file with RPZ_PRIMARY from node.env. unbound writes each zone it received to zonefile, so a
# restart, or the primary being away, does not leave a node without its lists.
#
# unbound checks them in this order and stops at the first match. deploy/rpz/dedupe.py relies on it, leaving out of a
# list what an earlier one already answers, so a change of order goes into ZONES in build-zones.sh too.
rpz:
  name: malware.rpz.vessel
  primary: RPZ_PRIMARY@5300
  zonefile: "/var/lib/unbound-rpz/malware.rpz"
  rpz-log: no
  tags: "malware ads"
  # clears RA in what this list blocks, so start.sh can count the blocks per device without logging names
  rpz-signal-nxdomain-ra: yes
  # Whatever an entry says, the answer is NXDOMAIN. deploy/rpz/lists.sh keeps only block entries already; this holds even
  # if a list gets past it with an entry that answers an address of its own, lets a name through or matches one
  # device's address. The same in the four zones below.
  rpz-action-override: nxdomain

rpz:
  name: tw165.rpz.vessel
  primary: RPZ_PRIMARY@5300
  zonefile: "/var/lib/unbound-rpz/tw165.rpz"
  rpz-log: no
  tags: "malware ads"
  # scam sites Taiwan's ISPs stop resolving, counted with the malware list
  rpz-signal-nxdomain-ra: yes
  rpz-action-override: nxdomain

rpz:
  name: twmoda.rpz.vessel
  primary: RPZ_PRIMARY@5300
  zonefile: "/var/lib/unbound-rpz/twmoda.rpz"
  rpz-log: no
  tags: "malware ads"
  # fake shops Taiwan's ISPs stop resolving on MODA's request, counted with the malware list
  rpz-signal-nxdomain-ra: yes
  rpz-action-override: nxdomain

rpz:
  name: stalkerware.rpz.vessel
  primary: RPZ_PRIMARY@5300
  zonefile: "/var/lib/unbound-rpz/stalkerware.rpz"
  rpz-log: no
  tags: "malware ads"
  # stalkerware domains Echap collects, counted with the malware list
  rpz-signal-nxdomain-ra: yes
  rpz-action-override: nxdomain

rpz:
  name: cti.rpz.vessel
  primary: RPZ_PRIMARY@5300
  zonefile: "/var/lib/unbound-rpz/cti.rpz"
  rpz-log: no
  tags: "malware ads"
  # DNSBunker's active malicious domains, counted with the malware list
  rpz-signal-nxdomain-ra: yes
  rpz-action-override: nxdomain

rpz:
  name: ads.rpz.vessel
  primary: RPZ_PRIMARY@5300
  zonefile: "/var/lib/unbound-rpz/ads.rpz"
  rpz-log: no
  # 10.8.1.254 only
  tags: "ads"
  # answers with a CNAME to blocked.vessel. (a name that does not exist, see local-zone in filter.conf), so start.sh can
  # count ads and trackers apart from the malware list, per device and without logging names
  rpz-action-override: cname
  rpz-cname-override: "blocked.vessel."
