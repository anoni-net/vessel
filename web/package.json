{
  "name": "vessel-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/prerender.tsx && node scripts/prerender.mjs",
    "build:onion": "VESSEL_TARGET=onion npm run build",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "preview:onion": "VESSEL_TARGET=onion vite preview --host 127.0.0.1 --port 4175 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "playwright test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@noble/curves": "2.4.0",
    "preact": "11.0.1",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "axe-core": "4.10.2",
    "preact-render-to-string": "6.8.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
